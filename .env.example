# Web - safe for browser
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key

# Worker - server only. NEVER expose in NEXT_PUBLIC_*
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Extractor configuration - leave empty until provider is selected
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
