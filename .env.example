# Web - safe for browser. Use values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Worker - server only. NEVER expose in NEXT_PUBLIC_*.
# For development from an IPv4 network, Supabase recommends the Session pooler connection string.
# Dashboard > Connect > Session pooler. Add ?sslmode=require if it is not already present.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional compatibility for a future self-hosted Supabase installation using legacy JWT keys.
SUPABASE_SERVICE_ROLE_KEY=

# Extractor configuration - Sprint 1C; leave empty for now.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
