# Database connection used only by services/worker (server-side).
# Example: PostgreSQL Session Pooler connection from Supabase > Connect.
DATABASE_URL=

# Supabase client/server configuration. Do not commit real keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Structured epidemiological extraction (Sprint 1C).
# The worker currently implements provider=openai through the Responses API
# with Structured Outputs. Keep the API key only in the root .env.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=
